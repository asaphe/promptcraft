// Claude Code settings.json — Hook configuration patterns
//
// Hooks intercept tool calls at specific lifecycle points.
// This shows three common patterns:
// 1. PreToolUse hook that rewrites Bash commands (RTK token optimization)
// 2. Stop hook that can hold a turn end (context-budget handoff)
// 3. StatusLine command that shows contextual info in the CLI
{
  // Environment variables available to Claude Code
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },

  "hooks": {
    // PreToolUse hooks fire BEFORE a tool executes.
    // They can:
    //   - Allow the call (exit 0, no output)
    //   - Rewrite the call (output JSON with updatedInput)
    //   - Block the call (output JSON with permissionDecision: "deny")
    "PreToolUse": [
      {
        // Only apply this hook to Bash tool calls
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            // This hook rewrites commands to use RTK for token-optimized output.
            // The hook script receives the tool input as JSON on stdin and can
            // return modified input via stdout.
            "command": "$HOME/.claude/hooks/rtk/rtk-rewrite.sh",
            // Always declare a timeout: a hook killed at its timeout is a non-blocking error and the tool runs.
            "timeout": 30
          }
        ]
      }
    ],

    // Stop hooks fire as Claude ends a turn; {"decision":"block","reason":...} keeps it going with the reason as an instruction.
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            // Acts on the over-budget flag the statusline below writes; see hooks/context-budget-stop/README.md.
            "command": "$HOME/.claude/hooks/context-budget-stop/context-budget-stop.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },

  // StatusLine shows persistent context below the input line.
  // The command receives session JSON on stdin and outputs styled text.
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}
