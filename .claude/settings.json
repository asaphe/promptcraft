{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git fetch *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/merge-grant.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stateful-op-reminder.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".claude/hooks/destructive-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".claude/hooks/pr-create-guard.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/merge-grant.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
